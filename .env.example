# Copy to .env and fill in. Never commit .env.

# --- Database ---
DB_PASSWORD=bloodbank
# Only needed outside docker compose (e.g. a hosted MySQL):
# DB_URL=jdbc:mysql://<host>:<port>/<db>?sslMode=REQUIRED&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh
# DB_USERNAME=

# --- Security ---
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
ADMIN_EMAIL=admin@bloodbank.local
ADMIN_PASSWORD=Admin@123

# --- Mail (optional: without it, emails are logged as failed and the app keeps working) ---
MAIL_USERNAME=
# Gmail App Password: https://myaccount.google.com/apppasswords
MAIL_PASSWORD=
ADMIN_CONTACT_EMAIL=

# --- Hosted Redis / RabbitMQ (optional, docker compose provides both) ---
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=
# REDIS_SSL=true
# RABBITMQ_URL=amqps://user:pass@host/vhost
